# ==============================================================================
# BEL DISTRIBUCIONES — Variables de entorno
# Copiar a .env.local (NO subir a git)
# ==============================================================================

# --- BASE URL ---
# En dev: http://localhost:3000
# En Vercel: https://bel-distribuciones.vercel.app (o tu dominio)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- WHATSAPP (número público del negocio para los botones del sitio) ---
# Con código de país, sin espacios ni signos. Ej: 5492914000000
NEXT_PUBLIC_WHATSAPP=5492910000000

# --- SUPABASE ---
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# --- MERCADO PADO ---
# Developers > Credenciales
# IMPORTANTE: usar la misma cuenta que DALT si cobran a la misma cuenta,
# o crear una app nueva si Bel factura aparte.
MP_ACCESS_TOKEN=APP_USR-xxxxx

# --- GETNET ARGENTINA (Get Checkout, corre sobre GeoPagos) ---
# La API AR solo necesita Client ID + Secret (NO usa seller_id).
# Generar las credenciales en el portal: Productos Digitales > Integraciones > Checkout API.
# IMPORTANTE: el producto "Checkout API" debe estar ACTIVADO por Getnet para que
# las credenciales autentiquen; si no, el token devuelve 401.
# Poner NEXT_PUBLIC_GETNET_ENABLED=true para mostrar la opción en el checkout.
NEXT_PUBLIC_GETNET_ENABLED=false
GETNET_CLIENT_ID=
GETNET_CLIENT_SECRET=
# Opcionales (solo si Getnet indica otros hosts):
# GETNET_TOKEN_URL=https://auth.geopagos.com/oauth/token
# GETNET_BASE_URL=https://api.globalgetnet.com.ar/api/v2

# --- RESEND (emails transaccionales) ---
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxx
FROM_EMAIL=Bel Distribuciones <no-reply@beldistribuciones.com.ar>
OWNER_EMAIL=ventas@beldistribuciones.com.ar

# --- CORREO ARGENTINO / PAQ.AR (cotización de envíos, API MiCorreo) ---
# La cotización usa la API "MiCorreo" (/rates). Auth: user+password (Basic Auth)
# que Correo entrega por ambiente, + el customerId de la cuenta MiCorreo.
# Si se dejan vacíos, se usan tarifas estimadas fijas (no bloquea el checkout).
# Prod: https://api.correoargentino.com.ar/micorreo/v1
# Test: https://apitest.correoargentino.com.ar/micorreo/v1
CORREO_API_BASE=https://api.correoargentino.com.ar/micorreo/v1
CORREO_USER=
CORREO_PASSWORD=
CORREO_CUSTOMER_ID=
CORREO_CP_ORIGEN=8000

# --- CORREO ARGENTINO / PAQ.AR (generar envío + rótulo, API PAQ.AR) ---
# API distinta de la de cotización: da de alta el envío y genera el rótulo (PDF)
# que queda en el panel admin. Auth: agreement (id de acuerdo) + API-Key.
# Prod: https://api.correoargentino.com.ar/paqar/v1
# Test: https://apitest.correoargentino.com.ar/paqar/v1
PAQAR_API_BASE=https://api.correoargentino.com.ar/paqar/v1
PAQAR_AGREEMENT=
PAQAR_API_KEY=
# Código de calidad de servicio (2 letras) que indica Correo. Default: CP.
PAQAR_SERVICE_TYPE=CP

# --- WHATSAPP (opcional, via Twilio) ---
# Si se dejan vacíos, no se envían notificaciones por WhatsApp.
# https://console.twilio.com
OWNER_WHATSAPP=+5492910000000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
